# Pipeline environment variables
# GitHub Token — used to access GitHub Models API (models.github.ai)
# Automatically available in GitHub Actions; for local dev use a PAT with models:read scope
GITHUB_TOKEN=ghp_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Optional — enables pre-match squad data (fetch_squads.py) and player career stats
# (fetch_player_stats.py). Fixtures, results, and predictions work without this key.
# CRICAPI_KEY=your-cricapi-key
